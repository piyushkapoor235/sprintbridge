# Copy to backend/.env for local development. Never commit the real file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-owned writes only (skill evidence, job requirements, seed). Never sent to the browser.
SUPABASE_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173
# Database owner connection (session pooler, IPv4). Migrations and seed only; never used by the API.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Shared password for the synthetic demo accounts created by database/seed.py.
DEMO_PASSWORD=
# Claude API key for resume/JD skill extraction (optional; without it those endpoints return 503).
ANTHROPIC_API_KEY=
